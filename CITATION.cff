  type: article
  authors:
    - family-names: Berthommier
      given-names: Frédéric
  title: 'A mathematical model of the vowel space'
  journal: 'arXiv preprint arXiv:2111.00868 (JASA Express Letters submission)'
  year: 2021
  doi: 10.48550/arXiv.2111.00868
